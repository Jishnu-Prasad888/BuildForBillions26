# Root copy for reference. The backend reads backend/.env (copy backend/.env.example there).
APP_ENV=development
DEBUG=true

# Demo mode: mock government form, mock submission, mock status updates
DEMO_MODE=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/public_service_ai

# Vector backend: "chroma" (default), "pgvector", or "json" (pure-Python cosine fallback).
# Chroma is embedded and persisted in CHROMA_DIR unless CHROMA_HOST points at a Chroma server.
VECTOR_BACKEND=chroma
CHROMA_DIR=./data/chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Monitoring with Sentry (optional): leave SENTRY_DSN empty to disable. Use a Python project's DSN.
# Never sends PII: no request bodies, headers, cookies or local variables; ID numbers, phones, emails
# and tokens are redacted (see app/monitoring.py and the README, "Monitoring with Sentry").
SENTRY_DSN=
# Defaults to APP_ENV.
# SENTRY_ENVIRONMENT=development
# Deployed version, e.g. the git SHA, so errors are tied to a release.
# SENTRY_RELEASE=
# Tells replicas apart in Sentry; falls back to the container hostname.
# SENTRY_SERVER_NAME=
# Fraction of requests traced. Keep it low: cost grows with traffic.
SENTRY_TRACES_SAMPLE_RATE=0.05
# Profiling is off by default.
# SENTRY_PROFILES_SAMPLE_RATE=0.0

# Frontend Sentry (a Browser project's DSN). Unlike the backend settings above, docker compose reads this one from
# the project-root .env and bakes it into the frontend bundle at build time, so rebuild the frontend after changing it.
# Empty = the browser SDK is not shipped at all.
FRONTEND_SENTRY_DSN=

# Scraped scheme library ingested into the knowledge base (meta.json + content.txt per folder)
SCHEME_DIR=../scheme
SCHEME_AUTO_SYNC=true

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_CONNECT_RETRIES=10

# =========================
# AI PROVIDER
# =========================
# ollama | openai | kimi
LLM_PROVIDER=ollama
# Model used for generation
LLM_MODEL=qwen3:8b
# Optional vision-capable model for screen understanding (leave empty to disable).
# e.g. qwen2.5vl:7b (Ollama) or gpt-4o-mini (OpenAI)
VISION_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# =========================
# EMBEDDINGS
# =========================
# ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model output size (nomic-embed-text = 768)
EMBEDDING_DIM=768

# =========================
# OLLAMA
# =========================
# In Docker: http://ollama:11434  |  Ollama on your host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# =========================
# OPENAI
# =========================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# KIMI (Moonshot, OpenAI-compatible)
# =========================
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# If the configured provider is unreachable, fall back to deterministic
# (non-LLM) answer composition + hashed embeddings so the demo keeps working.
# The UI and /api/health/ai clearly report when fallback is active.
AI_FALLBACK_ENABLED=true

# Authentication
JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Files
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=52428800

# Seed data location (docs, graph, form definitions)
SEED_DIR=../data/seed

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# TELEGRAM BOT
# =========================
# Get a token from @BotFather on Telegram.
# Leave empty to disable the Telegram bot.
TELEGRAM_BOT_TOKEN=

# =========================
# WHATSAPP BOT (Meta WhatsApp Cloud API)
# =========================
# See WHATSAPP_SETUP.md. Leave token or phone number id empty to disable.
# Webhook URL to register in Meta: https://<your-domain>/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic). Used to verify webhook signatures; set it in production.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
