# Deployment secrets for docker-compose.prod.yml. Copy to .env.prod (git-ignored).
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
JWT_SECRET_KEY=

# Public URL users open (used for CORS), e.g. https://sahayak.example.org
PUBLIC_ORIGIN=http://localhost
HTTP_PORT=80

# Monitoring with Sentry (optional). Use two projects: one Python (backend), one Browser (frontend).
# Leave empty to run without it. The frontend DSN is baked in at build time, so rebuild after changing it.
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
# Fraction of requests traced. Keep low (0.01-0.05) for millions of users: cost grows with traffic.
SENTRY_TRACES_SAMPLE_RATE=0.02
# Deployed version (git SHA) so errors are tied to a release and regressions are visible.
RELEASE=

# Scale: API containers × uvicorn processes per container
API_REPLICAS=3
WEB_CONCURRENCY=2
