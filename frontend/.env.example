# Only needed when running the frontend outside Docker (`npm run dev`); Vite reads frontend/.env.
# With Docker Compose the same values come from FRONTEND_SENTRY_DSN in the root .env (see .env.example).
#
# Sentry crash and API-failure reporting for the browser (optional). Use a Browser project's DSN.
# Leave VITE_SENTRY_DSN empty to run without it: the SDK is then not even downloaded.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
# Fraction of page loads traced; the backend follows the same decision. Default 0.02.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.02
