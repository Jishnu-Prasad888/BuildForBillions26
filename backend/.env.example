APP_ENV=development
DEBUG=true

# Demo mode: mock government form, mock submission, mock status updates
DEMO_MODE=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/public_service_ai

# Vector backend: "pgvector" (recommended) or "json" (pure-Python cosine fallback)
VECTOR_BACKEND=pgvector

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_CONNECT_RETRIES=10

# =========================
# AI PROVIDER
# =========================
# ollama | openai | kimi
LLM_PROVIDER=ollama
# Model used for generation
LLM_MODEL=qwen3:8b
# Optional vision-capable model for screen understanding (leave empty to disable).
# e.g. qwen2.5vl:7b (Ollama) or gpt-4o-mini (OpenAI)
VISION_MODEL=
# OCR fallback for screen understanding when no vision model is configured (needs the
# Tesseract binary; the Docker image includes it). Set TESSERACT_CMD if it isn't on PATH,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENABLED=true
TESSERACT_CMD=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# =========================
# EMBEDDINGS
# =========================
# ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model output size (nomic-embed-text = 768)
EMBEDDING_DIM=768

# =========================
# OLLAMA
# =========================
# In Docker: http://ollama:11434  |  Ollama on your host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# =========================
# OPENAI
# =========================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# KIMI (Moonshot, OpenAI-compatible)
# =========================
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# If the configured provider is unreachable, fall back to deterministic
# (non-LLM) answer composition + hashed embeddings so the demo keeps working.
# The UI and /api/health/ai clearly report when fallback is active.
AI_FALLBACK_ENABLED=true

# Authentication
JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Files
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=52428800

# AI Form Assistant: private storage for uploaded forms (per user / per form) and limits.
# Must NOT be inside a publicly served directory; files are only reachable via authenticated endpoints.
FORMS_DIR=./data/users
MAX_FORM_SIZE_MB=25
MAX_FORM_PAGES=40
# LLM refines detected field types/required flags using labels only (never entered values)
FORM_LLM_ENABLED=true
# Optional TTF for non-Latin text (Hindi/Kannada) when filling PDFs, e.g. /usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
FORM_FONT_PATH=

# Seed data location (docs, graph, form definitions)
SEED_DIR=../data/seed

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# TELEGRAM BOT
# =========================
# Get a token from @BotFather on Telegram.
# Leave empty to disable the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Run the re-embed loop and Telegram bot in this process. With several API
# replicas, keep this true in exactly one container (see docker-compose.prod.yml).
RUN_BACKGROUND_TASKS=true

# =========================
# RATE LIMITING (GCRA)
# =========================
# Format: count/period:burst  (period = second | minute | hour; burst defaults to count)
# Keyed per signed-in user, else per client IP. Set REDIS_URL so limits are shared by
# all replicas/workers (required in production); without it they are per process.
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_DEFAULT=180/minute:60
# sign-in, sign-up, password reset (per IP: guards against password guessing)
RATE_LIMIT_AUTH=20/minute:10
# AI chat, KAG queries, screen-assistance turns (per user: LLM cost)
RATE_LIMIT_AI=20/minute:8
RATE_LIMIT_UPLOAD=10/minute:5
